DATABASE_URL="postgresql://inside:inside@localhost:5432/inside_the_game"
API_PORT=4000
# API origin used server-side by the Next.js web and admin apps (defaults to http://localhost:4000).
# API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
# Public fan web app origin. Partner API and webhook media URLs are made absolute with it.
# PUBLIC_WEB_URL=https://ca-web.example.azurecontainerapps.io

# Shared secret for admin endpoints (generate a long random string)
ADMIN_TOKEN=
# Synthetic match replay speed (1 = real time, 10 = ten times faster for demos)
REPLAY_SPEED=1
# Password for the admin app (username: admin)
ADMIN_PASSWORD=
# Fans get an opaque HttpOnly guest cookie for uploads and SOS. Set true when the API is served over HTTPS.
FORCE_SECURE_COOKIES=false
# Set true only when the API sits behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Write routes are rate limited per IP in-process (media 12/10min, SOS 6/5min, admin 300/min).
# Move to a shared store (Redis) before running more than one API instance.

# Media storage. Development uses local disk; deployed instances use a private Azure Blob container.
MEDIA_STORE=local
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_CONTAINER=media
# Optional connection string (otherwise the SDK uses managed identity / az login).
# AZURE_STORAGE_CONNECTION_STRING=
# Optional local staging directory (defaults to ./uploads).
# UPLOAD_DIR=

# AI agents (packages/ai). Choose one provider explicitly. Leave AI_PROVIDER empty to run without AI.
# Microsoft Foundry - Azure OpenAI (works on free-trial subscriptions; OpenAI-compatible route).
AI_PROVIDER=azure-openai
AZURE_OPENAI_RESOURCE=
AZURE_OPENAI_API_KEY=
# Optional full base URL (defaults to https://<resource>.services.ai.azure.com/openai/v1).
# AZURE_OPENAI_BASE_URL=
# Microsoft Foundry - Claude (Anthropic-compatible route; requires Claude quota).
# AI_PROVIDER=microsoft-foundry
# ANTHROPIC_FOUNDRY_RESOURCE=
# ANTHROPIC_FOUNDRY_API_KEY=
# ANTHROPIC_FOUNDRY_BASE_URL=
# Direct Claude API fallback for local dev; set AI_PROVIDER=anthropic to acknowledge using it.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# AI_ENABLED=true
# Model, or the Foundry deployment name
AI_MODEL=gpt-5-mini
# Opt in before sending SOS descriptions/seat data to a model. Keep false until consent/retention is approved.
AI_INCIDENT_TRIAGE=false
