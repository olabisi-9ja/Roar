{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:https", "-w", "@inside/web"],
      "port": 3001,
      "url": "https://localhost:3001"
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@inside/admin"],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "-w", "@inside/web", "--", "-p", "3002"],
      "port": 3002
    }
  ]
}
