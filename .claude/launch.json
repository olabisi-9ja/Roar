{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:https", "-w", "@inside/web"],
      "port": 3001,
      "url": "https://localhost:3001"
    },
    {
      "name": "web-live-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@inside/web", "--", "-p", "3003"],
      "env": { "API_URL": "https://ca-api.wittyocean-f89cf633.eastus2.azurecontainerapps.io" },
      "port": 3003
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@inside/admin"],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "-w", "@inside/web", "--", "-p", "3002"],
      "port": 3002
    }
  ]
}
